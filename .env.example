# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it contains secrets.

# -----------------------------------------------------------------------------
# PostgreSQL (Neon or Supabase)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DATABASE?sslmode=require"

# Neon: use the non-pooler host for migrations when using a pooled DATABASE_URL
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DATABASE?sslmode=require"

# -----------------------------------------------------------------------------
# Redis (Upstash) — Phase 7+
# -----------------------------------------------------------------------------
REDIS_URL="redis://default:TOKEN@HOST.upstash.io:6379"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secures /api/cron/expire-reservations in production (Authorization: Bearer <secret>)
CRON_SECRET="generate-a-random-string"

# Optional — reserved for distributed locking (not required for core flow)
# REDIS_URL="redis://..."
